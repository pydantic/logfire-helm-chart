    "host": "shared local Docker Desktop Linux/aarch64 VM",
    "vcpus": 10,
    "vm_memory_bytes": 8218034176,
    "collector_memory_limit_bytes": 2147483648,
    "collector_gomemlimit": "1228MiB",
    "swap_disabled": true,
    "backend": "local synthetic HTTP sink",
    "cluster_credentials_used": false
  },
  "method": {
    "throughput": "8 concurrent persistent HTTP clients, 3s warmup, 15s/20s measurement; one record per request; shared-host rates vary and are not production capacity guarantees",
    "delivery": "Track unique IDs of every HTTP-200-acknowledged record; follow-up cases wait for zero queue size and up to 10s for downstream delivery; report unknown client transport-error outcomes separately",
    "storage": "Linux-local Docker volumes for normal/I/O tests; a bounded tmpfs with retained mount and filler file only for the ENOSPC fault test",
    "retry": "100ms initial / 1s maximum backoff, expiry disabled to isolate storage losses; production retry settings are unchanged",
    "scaled_tests": "Tiny-request cases use 4MiB queue and 8MiB/16MiB database limits; these reproduce overhead/error handling, not full-size production capacity"
  },
  "conclusions": [
    "Memory queues remain the default; disk is opt-in.",
    "Three full-size mixed-signal fill/drain cycles delivered all acknowledged records in both modes; disk completed nine compactions.",
    "The 2x database budget rejected tiny requests before the byte queue filled and lost acknowledged records on storage exhaustion in two runs.",
    "The 4x database budget held the same 37263 tiny requests as memory and delivered all acknowledged records in that tested workload.",
    "Fsync adds throughput/latency cost; disabling it improved throughput in a repeat but does not fix storage-full failures.",
    "Constrained disk I/O caused seconds of receiver latency and client timeouts despite mostly empty queues.",
    "The ENOSPC fault recovered for new traffic after space was freed, but three of six initially acknowledged records were lost."
  ],
